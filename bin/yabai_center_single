#!/usr/bin/env bash
#
# Usage: yabai_center_single <max-width>    center lone tiled windows at <max-width>
#        yabai_center_single refresh        the same, with <max-width> from yabairc
#        yabai_center_single pause [space]  stop all padding changes until resume
#        yabai_center_single resume         restore the paused space's padding, center again
#
# Keeps a lone tiled window on a wide display from stretching across the
# whole screen. yabai has no per-window maximum width, but it tiles into the
# space area minus the space padding. So whenever a space holds exactly one
# tile and that tile would end up wider than <max-width>, this widens the
# left and right padding of the space to center the tile at <max-width>.
# Every other space gets the global left and right padding. The script
# therefore owns the left and right padding of every tiling space: a value
# set by hand is overwritten by the next window event, and "pause" is the
# way to keep one.
#
# <max-width> is in points, the unit yabai uses for every frame and padding.
# It doubles as the display threshold: on a display too narrow to produce a
# tile wider than <max-width>, no space ever gets centered. A stack (a stack
# layout space or stacked windows in one node) counts as one tile, since it
# shows one window at a time. The width comes from the full display frame,
# so a Dock shown on the left or right edge of a wide display makes the tile
# narrower than <max-width>.
#
# yabairc runs this from signals and is the one place <max-width> is set;
# "refresh" reads it back from those signals. Floating the only tiled window
# of a space resizes no other window, so no window_resized signal arrives,
# and an skhd binding that toggles float runs "refresh" afterwards.
#
# "pause" is for tools that set their own per-space padding, such as
# yabai_recording, which passes the space it changes. "resume" puts the
# global padding back on that space and centers again.
#
# Failed and slow passes are logged with a timestamp to
# ~/Library/Logs/yabai_center_single.log.

set -euo pipefail

# The per-user temporary directory cannot hold files planted by other
# accounts, which /tmp can. getconf gives the same path to yabai's signals,
# skhd and an interactive shell, whatever their environment.
state_dir=$(getconf DARWIN_USER_TEMP_DIR)
pause_file="${state_dir%/}/yabai_center_single.paused"
dirty_file="${state_dir%/}/yabai_center_single.dirty"
run_lock="${state_dir%/}/yabai_center_single.run"

# yabai's signals and skhd's refresh run with different stderr, and any of
# them can become the runner, so log lines go to one file whatever started
# the run. ~/Library/Logs outlives the temporary directory, which macOS
# clears of unused files. A terminal gets the lines as well.
log_file="$HOME/Library/Logs/yabai_center_single.log"

log() {
    local line
    line="$(date '+%F %T') yabai_center_single: $*"
    { printf '%s\n' "$line" >>"$log_file"; } 2>/dev/null || true
    if [ -t 2 ]; then
        printf '%s\n' "$line" >&2
    fi
}

usage() {
    cat >&2 <<'EOF'
usage: yabai_center_single <max-width>    center lone tiled windows at <max-width> points
       yabai_center_single refresh        the same, with <max-width> from the yabairc signals
       yabai_center_single pause [space]  stop all padding changes until resume
       yabai_center_single resume         restore the paused space's padding, center again
EOF
    exit 64
}

# Prints nothing when no centering signal is registered, which means
# centering is off. The list is tested for an answer before jq sees it,
# because jq prints nothing both for that case and for an empty answer from
# a yabai that could not serve the request. Such a failure is retried like a
# failed pass.
registered_max_width() {
    local attempt signals
    for attempt in 1 2 3 4 5; do
        if signals=$(yabai -m signal --list) && [ -n "$signals" ]; then
            jq -r 'first(.[].action
                         | capture("yabai_center_single (?<width>[0-9]+)$").width)
                   // empty' <<< "$signals"
            return
        fi
        if [ "$attempt" -lt 5 ]; then
            sleep 1
        fi
    done
    log "could not read the signal list after $attempt tries, centering not applied"
    return 1
}

# =========================================================
# Centering
# =========================================================

center() {
    local max_width=$1

    # yabai forks one process per signal without waiting for any of them,
    # and window_resized arrives in bursts (a relayout resizes every window
    # of a space, a mouse resize sends one per step). Every instance first
    # marks the state dirty and then tries to become the one runner. An
    # instance that finds the run lock taken exits at once and leaves its
    # mark to the runner, which passes over the spaces until a pass ends
    # with no mark left. The runner applies its own <max-width> to every
    # pass, including passes for marks that other instances left; a changed
    # width arrives with the first event after the runner ends.
    #
    # The runner has no time limit. A run has held the lock for more than
    # 10 s, cause not known. yabai handles every request and every signal on
    # one event loop, so while that loop is blocked, every yabai call of the
    # runner waits and yabai sends no signals. It sends the signals for the
    # events in between once it recovers, and their marks give the runner
    # another pass.
    touch "$dirty_file"

    local failures started elapsed watchdog passed
    while :; do
        exec 9>>"$run_lock"
        /usr/bin/lockf -s -t 0 9 || return 0

        failures=0
        while [ -e "$dirty_file" ]; do
            # The pause file is the guard against writes during a pause:
            # every pass tests it under the run lock, so once it exists no
            # new pass starts. The mark stays for the run that "resume"
            # starts.
            if [ -e "$pause_file" ]; then
                return 0
            fi

            # The mark goes before the queries, so an event that arrives
            # during this pass sets it again and gets a pass of its own.
            rm -f "$dirty_file"

            # A pass that hangs would log nothing until it returns, so a
            # watchdog reports it while it runs: after 3 s, then every 30 s.
            # The watchdog first closes its copy of fd 9. The run lock
            # belongs to that open file, so a copy held by the watchdog or
            # its sleep would keep the lock after the runner releases it.
            # The TERM trap takes the running sleep along when the runner
            # stops the watchdog, and a watchdog whose runner is gone ends
            # by itself.
            started=$SECONDS
            (
                exec 9>&-
                runner=$$ sleeper='' waited=0 interval=3
                trap '[ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null; exit 0' TERM
                while :; do
                    sleep "$interval" &
                    sleeper=$!
                    wait "$sleeper"
                    sleeper=''
                    kill -0 "$runner" 2>/dev/null || exit 0
                    waited=$((waited + interval))
                    log "a pass has been running for $waited s"
                    interval=30
                done
            ) &
            watchdog=$!
            if reconcile "$max_width"; then
                passed=1
            else
                passed=
            fi
            kill "$watchdog" 2>/dev/null || true
            wait "$watchdog" 2>/dev/null || true

            # $SECONDS counts whole seconds, so a reading of 3 means the pass
            # took more than 2 s. Shorter passes are not worth a line.
            elapsed=$((SECONDS - started))
            if [ "$elapsed" -ge 3 ]; then
                log "a pass took $elapsed s"
            fi

            if [ -n "$passed" ]; then
                failures=0
                continue
            fi

            # A failed pass means yabai could not serve a request right
            # then. Passes write absolute values, so repeating one is safe,
            # and a space that disappeared meanwhile is missing from the
            # next pass's query. Only a yabai that keeps failing ends the
            # run, and the mark stays for the next event.
            touch "$dirty_file"
            failures=$((failures + 1))
            if [ "$failures" -ge 5 ]; then
                log "giving up after $failures failed passes, the next event retries"
                return 1
            fi
            sleep 1
        done

        # An instance can set its mark after the last test above and then
        # fail to get the lock this runner still holds. Testing the mark
        # once more after releasing the lock picks that event up: either
        # the mark is visible here, or the instance found the lock free and
        # runs itself. No test covers this: the window is a few
        # instructions wide, and only a hook in this script could hit it
        # on purpose.
        exec 9>&-
        [ -e "$dirty_file" ] || return 0
    done
}

# Writes the side padding every tiling space should have, skipping spaces
# that already have it. Returns non-zero when a yabai call fails or answers
# with nothing, which the yabai client does with exit 0 when the daemon
# closes the connection without a reply. A failed space does not stop the
# others in the same pass. Every call is checked here, because a function
# called as an "if" condition runs without errexit.
reconcile() {
    local max_width=$1

    local base_left base_right displays spaces desired
    base_left=$(yabai -m config left_padding) || return 1
    base_right=$(yabai -m config right_padding) || return 1
    displays=$(yabai -m query --displays) || return 1
    spaces=$(yabai -m query --spaces) || return 1

    # yabai reports the window of the first and of the last leaf of each
    # space's tree, 0 for an empty tree. Both being the same window means a
    # single tile. Invisible spaces are included: yabai lays out a space with
    # its current padding the moment it becomes visible, and a write to an
    # invisible space only marks it for that layout.
    #
    # The side padding is rounded up so the tile never exceeds <max-width>,
    # and never drops below the global padding when left and right differ.
    desired=$(jq -nr \
        --argjson max "$max_width" \
        --argjson left "$base_left" \
        --argjson right "$base_right" \
        --argjson displays "$displays" \
        --argjson spaces "$spaces" '
        $spaces[]
        | select(.type != "float" and (."is-native-fullscreen" | not))
        | . as $space
        | ($displays[] | select(.index == $space.display) | .frame.w | floor) as $display_width
        | if ."first-window" != 0
             and ."first-window" == ."last-window"
             and $display_width - $left - $right > $max then
              (($display_width - $max) / 2 | ceil) as $side
              | "\(.index) \([$side, $left] | max) \([$side, $right] | max)"
          else
              "\(.index) \($left) \($right)"
          end') || return 1

    # Every padding write makes yabai relayout the space, so only a
    # difference is written. A space that disappears between the query above
    # and its turn here fails its reads or its write, and the next pass no
    # longer lists it.
    local failed=0
    local space left right current_left current_right top bottom
    while read -r space left right; do
        [ -n "$space" ] || continue

        current_left=$(yabai -m config --space "$space" left_padding) \
            && [ -n "$current_left" ] || { failed=1; continue; }
        current_right=$(yabai -m config --space "$space" right_padding) \
            && [ -n "$current_right" ] || { failed=1; continue; }
        if [ "$current_left" -eq "$left" ] && [ "$current_right" -eq "$right" ]; then
            continue
        fi

        # --padding sets all four sides in one relayout. The current top and
        # bottom values go back in unchanged.
        top=$(yabai -m config --space "$space" top_padding) \
            && [ -n "$top" ] || { failed=1; continue; }
        bottom=$(yabai -m config --space "$space" bottom_padding) \
            && [ -n "$bottom" ] || { failed=1; continue; }
        yabai -m space "$space" --padding "abs:$top:$bottom:$left:$right" \
            || { failed=1; continue; }
    done <<< "$desired"
    return "$failed"
}

# =========================================================
# Pause and resume
# =========================================================

pause() {
    local space=${1:-}
    local created=1
    if [ -e "$pause_file" ]; then
        created=
    fi

    # The pause file holds the id of the space to restore on resume. The id
    # survives spaces being created, destroyed or reordered in between,
    # which shift the index. A second pause without a space keeps the space
    # recorded by the first.
    # The id is looked up before the file is written, so a failed lookup
    # leaves no pause behind that nobody asked for.
    if [ -n "$space" ]; then
        local space_id
        space_id=$(yabai -m query --spaces --space "$space" | jq -e '.id')
        printf '%s\n' "$space_id" > "$pause_file"
    elif [ -n "$created" ]; then
        : > "$pause_file"
    fi

    # The pause file stops every later pass, since each pass tests it under
    # the run lock. Taking that lock here only waits out the one pass that
    # may have started before the file existed. After this, nothing
    # overwrites the caller's padding.
    exec 9>>"$run_lock"
    if ! /usr/bin/lockf -s -t 10 9; then
        if [ -n "$created" ]; then
            rm -f "$pause_file"
        fi
        echo "could not pause single window centering: a run has held the lock for 10 s" >&2
        exit 1
    fi
    echo "single window centering paused"
}

resume() {
    local space_id space
    if [ -e "$pause_file" ]; then
        space_id=$(cat "$pause_file")

        # The restore happens while the pause file still exists, so no run
        # can interleave with it.
        if [ -n "$space_id" ]; then
            space=$(yabai -m query --spaces \
                | jq --argjson id "$space_id" '.[] | select(.id == $id) | .index')
            if [ -n "$space" ]; then
                yabai -m space "$space" --padding "abs:$(yabai -m config top_padding):$(yabai -m config bottom_padding):$(yabai -m config left_padding):$(yabai -m config right_padding)"
            fi
        fi
        rm -f "$pause_file"
    fi
    echo "single window centering resumed"
}

# =========================================================
# Entry point
# =========================================================

case "${1:-}" in
    pause)
        pause "${2:-}"
        exit 0
        ;;
    resume)
        resume
        max_width=$(registered_max_width)
        ;;
    refresh)
        max_width=$(registered_max_width)
        ;;
    [1-9]*)
        case "$1" in
            *[!0-9]*) usage ;;
        esac
        max_width=$1
        ;;
    *)
        usage
        ;;
esac

# An empty width means yabairc registered no centering signals, so centering
# is switched off and refresh or resume have nothing to apply.
if [ -n "$max_width" ]; then
    center "$max_width"
fi
